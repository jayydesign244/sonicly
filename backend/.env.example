# Copy this to .env and fill in real values for local dev.
# In Railway, set these in the project's Variables tab.

# ─── Auth (Clerk) ─────────────────────────────────────────────────────
# From Clerk dashboard → API Keys → "JWKS URL" (or derive from your Frontend API URL)
# Example: https://clean-cougar-12.clerk.accounts.dev
CLERK_ISSUER=https://YOUR-FRONTEND-API.clerk.accounts.dev
# Optional: override the auto-derived JWKS URL
# CLERK_JWKS_URL=https://YOUR-FRONTEND-API.clerk.accounts.dev/.well-known/jwks.json

# ─── CORS ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# ─── OpenAI (chat + Whisper transcription) ────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Whisper model used for transcription
WHISPER_MODEL=whisper-1

# ─── ElevenLabs (voice clone + TTS for word replacement) ──────────────
# Required for the "replace word" flow in the editor. Without it, deletes
# still work but replaces will 503.
ELEVENLABS_API_KEY=
# TTS model. eleven_turbo_v2_5 is the best latency/quality tradeoff.
ELEVENLABS_TTS_MODEL=eleven_turbo_v2_5
# Premade voice used when the plan can't do Instant Voice Cloning.
# Default is "Sarah" (neutral, available on every plan). Override only
# if you want a different fallback timbre for your account.
ELEVENLABS_FALLBACK_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# Retry tuning for transient 429/5xx from ElevenLabs (sane defaults).
# ELEVENLABS_MAX_RETRIES=3
# ELEVENLABS_BASE_BACKOFF=0.75

# ─── Database (Supabase Postgres) ─────────────────────────────────────
# Session Pooler URI (Project Settings → Database → Connection string)
# Format: postgresql://postgres.PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Leave blank to use a local SQLite file (sonicly.db) for dev.
DATABASE_URL=

# ─── Storage (Supabase) ───────────────────────────────────────────────
# Project Settings → API. Required for audio uploads.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=audio

# Resemble AI (https://app.resemble.ai → API tab)
# RESEMBLE_PROJECT_UUID is the project the synth endpoint will charge against.
RESEMBLE_API_KEY=
RESEMBLE_PROJECT_UUID=
