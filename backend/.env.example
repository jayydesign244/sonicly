# Copy this to .env and fill in real values for local dev.
# In Railway, set these in the project's Variables tab.

# From Supabase dashboard → Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-super-long-jwt-secret

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app
